# Local-first settings. Copy to .env for a personal deployment.
MORROWHELM_HOST=127.0.0.1
MORROWHELM_PORT=8787
MORROWHELM_PASSWORD=change-me-now
# Keep the default .data directory inside this repository, or choose a private path.
MORROWHELM_DATA_DIR=.data
# Set true only when the app is served over HTTPS.
MORROWHELM_COOKIE_SECURE=false

# Optional: base URL of a compatible agent gateway.
# MORROWHELM_AGENT_BASE_URL=http://127.0.0.1:8080

# Local Codex CLI demo runtime. Codex uses its own ChatGPT login, not this app's API vault.
MORROWHELM_CODEX_COMMAND=codex
MORROWHELM_CODEX_MODEL=gpt-5.6-sol
MORROWHELM_CODEX_TIMEOUT_SECONDS=240
# auto uses live Codex when available and falls back to synthetic replay; use
# replay for a deterministic judge/demo URL, or live to require Codex CLI.
MORROWHELM_DEMO_MODE=auto
